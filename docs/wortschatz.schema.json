{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deutschstudio.local/wortschatz.schema.json",
  "title": "Deutschstudio Wortschatz file (one class meeting)",
  "type": "object",
  "required": ["schema", "class", "level", "meeting", "topic", "words"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "class": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "minLength": 1 },
    "meeting": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "topic": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "type": "string" } },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/word" }
    }
  },
  "definitions": {
    "lang2": {
      "type": "object",
      "required": ["id", "en"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "example": {
      "type": "object",
      "required": ["de", "id"],
      "additionalProperties": false,
      "properties": {
        "de": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      }
    },
    "word": {
      "type": "object",
      "required": ["id", "de", "typ", "modi", "bedeutung"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "de": { "type": "string", "minLength": 1 },
        "artikel": { "enum": ["der", "die", "das"] },
        "plural": { "type": "string" },
        "typ": { "enum": ["Nomen", "Verb", "Adjektiv", "Adverb", "Redewendung", "Wendung", "Wortfeld"] },
        "trennbar": { "type": "boolean" },
        "modi": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["mc", "tippen", "artikel"] }
        },
        "bedeutung": { "$ref": "#/definitions/lang2" },
        "synonyme": { "type": "array", "items": { "type": "string" } },
        "kollokationen": { "type": "array", "items": { "type": "string" } },
        "gegenteil": { "type": "array", "items": { "type": "string" } },
        "hinweis": { "$ref": "#/definitions/lang2" },
        "beispiele": { "type": "array", "items": { "$ref": "#/definitions/example" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "modi": { "contains": { "const": "artikel" } } }, "required": ["modi"] },
          "then": { "required": ["artikel"], "properties": { "artikel": { "enum": ["der", "die", "das"] } } }
        },
        {
          "if": { "properties": { "typ": { "const": "Wortfeld" } }, "required": ["typ"] },
          "then": { "properties": { "modi": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
